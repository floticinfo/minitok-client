{
  "name": "@flotic/minitok",
  "version": "1.3.2",
  "description": "Repository-aware autonomous coding workflow driver",
  "main": "src/index.js",
  "bin": {
    "minitok": "bin/minitok.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test",
    "lint": "eslint --max-warnings=0 bin src tests",
    "typecheck": "tsc -p tsconfig.json",
    "release:check": "npm test && npm run lint && npm run typecheck && npm audit --audit-level=high && node scripts/secret-scan.mjs && npm pack --dry-run --json && npm run test:packed-install && node VERIFY_CMD.mjs && npm run release:verify",
    "docs:check": "node scripts/documentation-consistency.mjs",
    "release:verify": "node scripts/release-verify.mjs",
    "test:packed-install": "node scripts/packed-install-smoke.mjs",
    "start": "node bin/minitok.js"
  },
  "keywords": [
    "ai",
    "coding",
    "autonomous",
    "workflow",
    "cli",
    "llm",
    "code-review",
    "planning",
    "verifier"
  ],
  "author": "Flotic LC.",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/floticinfo/minitok-client"
  },
  "bugs": {
    "url": "https://github.com/floticinfo/minitok-client/issues"
  },
  "homepage": "https://minitok.dev",
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "js-yaml": "^4.1.0",
    "undici": "^8.10.1"
  },
  "files": [
    "bin/",
    "src/",
    "scripts/verify.mjs",
    "scripts/release-verify.mjs",
    "scripts/secret-scan.mjs",
    "VERIFY_CMD.mjs",
    "scripts/documentation-consistency.mjs",
    "!src/**/*.test.js",
    "!src/cli/commands/admin-activate.js",

    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "EULA.md",
    "POLICY.md",
    "DATA_CLASSIFICATION.md"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.9.1",
    "typescript": "^5.7.2"
  }
}
