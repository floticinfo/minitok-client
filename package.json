{
  "name": "@flotic/minitok",
  "version": "1.3.1",
  "description": "Repository-aware autonomous coding workflow driver",
  "main": "src/index.js",
  "bin": {
    "minitok": "bin/minitok.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test src/**/*.test.js",
    "lint": "node -e \"const fs=require('fs'),path=require('path'),cp=require('child_process'); const roots=['bin','src']; const files=[]; const walk=d=>{for(const e of fs.readdirSync(d,{withFileTypes:true})){const p=path.join(d,e.name); if(e.isDirectory()) walk(p); else if(p.endsWith('.js')) files.push(p)}}; roots.forEach(walk); files.forEach(f=>cp.execFileSync(process.execPath,['--check',f],{stdio:'inherit'}))\"",
    "start": "node bin/minitok.js"
  },
  "keywords": [
    "ai",
    "coding",
    "autonomous",
    "workflow",
    "cli",
    "llm",
    "code-review",
    "planning",
    "verifier"
  ],
  "author": "Flotic LC.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/floticinfo/minitok-client"
  },
  "bugs": {
    "url": "https://github.com/floticinfo/minitok-client/issues"
  },
  "homepage": "https://minitok.dev",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "js-yaml": "^4.1.0"
  },
  "files": [
    "bin/",
    "src/",
    "scripts/verify.mjs",
    "VERIFY_CMD.mjs",
    "!src/**/*.test.js",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ]
}
